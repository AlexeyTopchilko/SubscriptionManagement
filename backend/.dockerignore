# Build output. Critical: a host-built obj/ carries absolute paths and a
# restore graph from the host SDK. Copying it into the image makes the
# in-image restore fail in ways whose error messages point nowhere useful.
bin/
obj/

# Local configuration and secrets — never into an image layer
appsettings.Development.json
.env
.env.*
*.user

# IDE / editor
.vs/
.idea/
.vscode/
*.suo

# Version control and Docker's own files
.git/
.gitignore
Dockerfile
.dockerignore

# Noise
*.log
*.tmp
*.swp
